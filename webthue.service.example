# Copy to /etc/systemd/system/webthue.service only after adjusting paths and permissions.
# HTTPS-only cookies require a properly configured HTTPS reverse proxy.
[Unit]
Description=WebThue - Ke Khai Vinh independent form support
After=network.target

[Service]
Type=simple
User=webthue
Group=webthue
WorkingDirectory=/opt/webthue/current
Environment=PYTHONUNBUFFERED=1
Environment=KEKHAI_DATA_DIR=/opt/webthue/shared/runtime
Environment=KEKHAI_HTTPS_ONLY=1
ExecStart=/opt/webthue/current/.venv/bin/python -m uvicorn portal.app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/webthue/shared/runtime
UMask=0077

[Install]
WantedBy=multi-user.target
